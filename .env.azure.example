# =============================================================
# Secrets du déploiement AZURE (lus par scripts/deploy.sh).
# Copier ce fichier :  cp .env.azure.example .env.azure
# Le fichier .env.azure ne doit JAMAIS être versionné (il est dans .gitignore).
# Configuration volontairement séparée du .env local (Docker Compose).
# Les valeurs sont envoyées dans les SECRETS des Container Apps, jamais dans l'image.
# =============================================================

# Email (Resend) : obligatoire au démarrage du backend.
# Une valeur factice suffit : l'envoi échoue, mais les résultats sont enregistrés.
RESEND_API_KEY=re_dummy_cloud
FROM_EMAIL="Quiz App <noreply@votredomaine.com>"

# Administration : générer des valeurs aléatoires, par exemple :
#   openssl rand -hex 12   (mot de passe)
#   openssl rand -hex 32   (secret JWT)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=

# PostgreSQL cloud (J5) : chaîne de connexion Neon "pooled" (hôte en -pooler),
# laisser vide au J4. Remplacer sslmode=require par sslmode=verify-full.
# ⚠️ Entourer la valeur d'apostrophes : le "&" casserait la lecture du fichier.
# Format : DATABASE_URL='postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=verify-full&channel_binding=require'
DATABASE_URL=
