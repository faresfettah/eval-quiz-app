# Copier ce fichier en .env puis remplacer les valeurs :  cp .env.example .env
# Le fichier .env ne doit JAMAIS être versionné (il est dans .gitignore).

# --- PostgreSQL local (Docker Compose) ---
POSTGRES_USER=quiz_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quiz_db
# En local, DATABASE_URL est construite par docker-compose.yml (hôte "db").
# Sur Azure, DATABASE_URL = chaîne Neon, stockée dans un SECRET de la Container App :
# postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=verify-full

# --- Email (Resend) ---
# Obligatoire au démarrage du backend. Une valeur factice suffit en local
# (l'envoi d'email échoue, mais les résultats sont enregistrés).
RESEND_API_KEY=re_dummy_local
FROM_EMAIL=Quiz App <noreply@votredomaine.com>

# --- Administration ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-long-random-string
